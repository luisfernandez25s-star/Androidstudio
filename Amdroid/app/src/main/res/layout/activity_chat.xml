<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/racing_black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chat Celular ↔ Reloj"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/racing_yellow"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="Bienvenido al chat..." />
    </ScrollView>

    <EditText
        android:id="@+id/editMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escribe un mensaje"
        android:textColor="@color/white"
        android:textColorHint="#999999"
        android:backgroundTint="@color/racing_yellow" />

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enviar al reloj"
        android:backgroundTint="@color/racing_yellow"
        android:textColor="@color/black" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar en Base de Datos"
        android:backgroundTint="#00C853"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnShow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostrar en la vista del chat"
        android:backgroundTint="#2196F3"
        android:textColor="@color/white" />
</LinearLayout>
